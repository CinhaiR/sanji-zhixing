# ============================================================
# 三晋智行 后端配置模板
# 复制为 .env 后填入真实值。.env 不要提交到版本库。
#
# 说明：.env 的路径按「backend 目录」绝对解析（见 app/core/config.py），
# 因此无论从哪个目录启动进程都能读到，不必先 cd backend。
# ============================================================

# 服务配置
APP_NAME=三晋智行后端
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
# 前端开发服务器地址（用于面板展示）
FRONTEND_URL=http://localhost:5173
# 由后端托管前端构建产物：打开后只需运行后端，访问 8000 端口即完整站点。
# 若频繁改前端代码、想用 Vite 热更新，可设为 false
SERVE_FRONTEND=true
FRONTEND_DIST=frontend/dist
# 监听前端源码改动并自动重新构建（改完只需刷新浏览器）
AUTO_BUILD_FRONTEND=true
# 改动防抖秒数：编辑器一次保存常触发多个事件，合并成一次构建
FRONTEND_WATCH_DEBOUNCE=1.0

# 数据库 (SQLite 开发用，生产可换 PostgreSQL/MySQL)
DATABASE_URL=sqlite:///./sanji_zhixing.db

# CORS 允许的来源（逗号分隔）。
# 前后端同源（后端托管前端）时用不到；分开部署或用不同端口时必填，
# 例如：CORS_ORIGINS=http://your-domain.com,http://www.your-domain.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------
# DeepSeek 大模型
#   行程生成用 DEEPSEEK_MODEL（推理模型，规划能力更强）
#   驿路谋士对话用 AGENT_DEEPSEEK_MODEL（非推理，首字延迟低）
# ------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=180
DEEPSEEK_MAX_TOKENS=8000
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.7

# ------------------------------------------------------------
# 驿路谋士对话链路
# deepseek = 项目内自建（知识库问答检索 + 提示词 + DeepSeek）
# xingchen = 转发讯飞星辰工作流（备用）
# ------------------------------------------------------------
AGENT_PROVIDER=deepseek
AGENT_DEEPSEEK_MODEL=deepseek-chat
AGENT_TEMPERATURE=0.3
AGENT_MAX_TOKENS=2000
AGENT_TIMEOUT=120
AGENT_RETRIEVAL_TOP=12
AGENT_KB_FILE=knowledge_txt/三晋智行_全量知识库（问答对）.txt
AGENT_PROMPT_FILE=prompts/讯飞大模型节点提示词.md

# ------------------------------------------------------------
# 行程生成缓存
# ------------------------------------------------------------
ENABLE_GENERATION_CACHE=true
CACHE_TTL_SECONDS=86400
CACHE_BACKEND=db

# ------------------------------------------------------------
# RAG 知识库与地理准确性（行程生成用）
# ------------------------------------------------------------
ENABLE_RAG=true
KNOWLEDGE_SEED_FILE=data/knowledge_seed.json
RETRIEVAL_MAX_ATTRACTIONS=6
RETRIEVAL_MAX_FOODS=7
STRICT_GEO_VALIDATION=true
AUTO_FIX_GEO=true

# ------------------------------------------------------------
# 讯飞星辰智能体工作流（备用，需平台侧授权与编排正常）
# ------------------------------------------------------------
XINGCHEN_API_KEY=
XINGCHEN_API_SECRET=
XINGCHEN_FLOW_ID=
XINGCHEN_BASE_URL=https://xingchen-api.xf-yun.com/workflow/v1
XINGCHEN_TIMEOUT=120
XINGCHEN_INPUT_KEY=AGENT_USER_INPUT
XINGCHEN_SEND_HISTORY=true
XINGCHEN_HISTORY_ROUNDS=4

# ------------------------------------------------------------
# Coze 工作流（旧方案，已弃用，留空即可）
# ------------------------------------------------------------
COZE_API_KEY=
COZE_BOT_ID=
COZE_BASE_URL=https://api.coze.cn

# ------------------------------------------------------------
# 前端单独的环境变量（不在本文件）
# 高德地图 Key 配在 frontend/.env（模板见 frontend/.env.example）
# ------------------------------------------------------------

# ------------------------------------------------------------
# JWT 认证与管理员
# ------------------------------------------------------------
# 生产环境务必修改为长随机字符串（可用：openssl rand -hex 32）
JWT_SECRET_KEY=sanji-zhixing-dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
# 首次启动自动创建的管理员账号：用户名可保留 admin，但密码必须修改
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-on-first-run
